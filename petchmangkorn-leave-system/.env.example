# ╔═══════════════════════════════════════════════════════════════════╗
# ║  Frontend Vite Env — ห้างทองเพชรมังกร ระบบการลา                  ║
# ║  Copy เป็น .env.production.local ถ้าจะ build เอง                  ║
# ║  (ปกติ deploy ผ่าน GitHub Actions ที่อ่านจาก Variables/Secrets)   ║
# ╚═══════════════════════════════════════════════════════════════════╝

# ─── Firebase Web Config (production build เท่านั้น) ───────────────
# dev ไม่ต้องตั้ง — ใช้ mock จาก src/firebase/firebaseConfig.json + Emulators
# หมายเหตุ: Firebase web apiKey ไม่ใช่ secret จริง (ฝัง client ได้)
#          ความปลอดภัยอยู่ที่ Firestore/Storage Rules + จำกัด key ใน GCP Console
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=petchmangkorn-bot.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=petchmangkorn-bot
VITE_FIREBASE_STORAGE_BUCKET=petchmangkorn-bot.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID
# ต้องตรงกับชื่อ named database ใน Firebase Console + firebase.json
VITE_FIRESTORE_DATABASE_ID=petchmangkorn-bot

# ─── Optional: เปิด-ปิด Firebase Emulators ─────────────────────
# ไม่ต้องตั้ง — เปิดอัตโนมัติตอน `npm run dev` (import.meta.env.DEV)
# VITE_USE_EMULATORS=false

# ─── LINE Login ────────────────────────────────────────────────
# Channel ID จาก LINE Developers Console (LINE Login channel)
# ต้องมีตอน `npm run build` เพราะ Vite ฝังค่านี้ลงใน bundle
VITE_LINE_LOGIN_CHANNEL_ID=YOUR_LINE_LOGIN_CHANNEL_ID

# ─── LINE secrets ──────────────────────────────────────────────
# access token / channel secret / ADMIN_LINE_USER_ID เก็บใน Firestore
# doc `config/secrets` (ไม่ใช่ไฟล์นี้) — ดู README.md ขั้นตอนที่ 2
